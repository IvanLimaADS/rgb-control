{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "CommonJS",
    "moduleResolution": "node",
    "outDir": "dist-electron",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": false
  },
  "include": [
    "src/main/**/*",
    "src/shared/**/*",
    "src/core/**/*",
    "src/providers/**/*",
    "src/profiles/**/*",
    "src/effects/**/*",
    "src/database/**/*",
    "src/services/**/*",
    "src/utils/**/*",
    "src/tests/**/*"
  ]
}
